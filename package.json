{
  "name": "tekken8-browser",
  "version": "1.0.0",
  "description": "Browser fighting game with deep Tekken-style mechanics",
  "type": "module",
  "main": "server.cjs",
  "scripts": {
    "start": "node server.cjs",
    "test": "node test/core.test.js",
    "test:core": "node test/core.test.js",
    "test:ws": "node test/ws.test.cjs",
    "test:game": "node test/game.test.mjs",
    "test:browser": "node test/browser.test.mjs",
    "test:all": "node test/core.test.js && node test/game.test.mjs && node test/ws.test.cjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  },
  "keywords": ["fighting-game", "tekken", "canvas", "browser", "rollback-netcode"],
  "license": "MIT"
}
